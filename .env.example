# RAG AI Tutor Environment Configuration

# App Settings
APP_NAME="RAG AI Tutor"
DEBUG=true
VERSION="1.0.0"
RUN_PORT=8002

# Database Settings
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="rag_ai_tutor"

# API Settings
API_HOST="127.0.0.1"
API_PORT=8000
API_PREFIX="/api"

# Security Settings
SECRET_KEY="your-secret-key-change-in-production-make-it-long-and-random"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/ML Settings
GEMINI_API_KEY="your-gemini-api-key-here"
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# File Upload Settings
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=".pdf,.docx,.txt"

# Vector DB Settings
CHROMA_PERSIST_DIRECTORY="chroma_data"
CHROMA_API_URL="http://127.0.0.1:8001/api/v2"
CHROMA_TENANT="default_tenant"
CHROMA_DATABASE="default_database"
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# CORS Settings (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000"

# Production Settings (uncomment for production)
# MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/rag_ai_tutor"
# DEBUG=false
# ALLOWED_ORIGINS="https://yourdomain.com"
# SECRET_KEY="your-production-secret-key"
